# Copy to .env and adjust. All values are optional — the defaults work locally.

# Port to listen on
PORT=3000

# Interface to bind. 0.0.0.0 makes it reachable from other devices on the
# network (needed to demo on a phone); 127.0.0.1 keeps it to this machine only.
HOST=0.0.0.0

# Where the SQLite database lives. On a hosting platform with an ephemeral
# filesystem, point this at a mounted persistent volume or the data is wiped
# on every redeploy.
DB_PATH=./data/barberiq.db

# ---------------------------------------------------------------------------
# Not yet wired up — see Part 4 of LAUNCH-GUIDE.md before going live.
# Listed here so the shape is obvious when you do connect them.
# ---------------------------------------------------------------------------

# Stripe (wallet top-ups). Credit the wallet from the webhook, never from the
# browser callback, or a customer can credit themselves by replaying it.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# SMS sending for reminders
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
